# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# --- Baza danych ---------------------------------------------------------
# Rola aplikacyjna: podlega RLS, używana przez API w czasie działania.
DATABASE_URL="postgresql://kelbroo_app:kelbroo_app@localhost:5432/kelbroo?schema=public"
# Rola właścicielska: omija RLS, używana wyłącznie przez migracje i seed.
DIRECT_DATABASE_URL="postgresql://kelbroo:kelbroo@localhost:5432/kelbroo?schema=public"

# --- Redis (pub/sub realtime, cache menu, rate limiting) ------------------
REDIS_PASSWORD="kelbroo"
REDIS_URL="redis://:kelbroo@localhost:6379"

# --- API ------------------------------------------------------------------
API_PORT=4000
# Originy aplikacji klienckich; w lokalnym testowaniu z telefonu dopisz adres w sieci LAN.
# Wszystkie cztery aplikacje stoją lokalnie pod innym originem niż API, więc
# każda musi tu być. Pominięcie którejkolwiek daje w przeglądarce „Failed to
# fetch" — błąd sieciowy, nie odpowiedź serwera, więc nie widać w nim przyczyny.
# 3001 gość · 3002 panel · 3003 strona produktowa · 3004 zaplecze
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"
NODE_ENV=development

# --- Aplikacje klienckie ----------------------------------------------------
# Przy testach z telefonu podmień na adres w sieci lokalnej (nie localhost).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Adres, który trafia do kodów QR drukowanych na stoliki.
NEXT_PUBLIC_GUEST_URL="http://localhost:3001"

# --- Auth personelu -------------------------------------------------------
JWT_ACCESS_SECRET="zmien-mnie-w-srodowisku-lokalnym"
JWT_REFRESH_SECRET="zmien-mnie-tez"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Sesje gości ----------------------------------------------------------
GUEST_SESSION_SECRET="zmien-mnie-rowniez"
GUEST_SESSION_TTL_HOURS=6

# --- Etap 2 (płatności online) — nieużywane w etapie 1 --------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- PayU (sandbox) --------------------------------------------------------
# Publiczne dane testowe PayU z developers.payu.com — wystarczają, żeby przejść
# całą ścieżkę zakupu lokalnie. Bez nich panel wyłącza przycisk „Zapłać".
#
# Powiadomienie o wpłacie PayU wysyła na PUBLIC_API_URL i **nie dosięgnie
# localhosta** — lokalnie wywołuje się je ręcznie albo tunelem (ngrok/cloudflared).
PAYU_ENV=sandbox
PAYU_POS_ID=300746
PAYU_CLIENT_ID=300746
PAYU_CLIENT_SECRET=2ee86a66e5d97e3fadc400c9f19b065d
PAYU_SECOND_KEY=b6ca15b0d1020e8094d9b5f8d163db54
PANEL_URL=http://localhost:3002
PUBLIC_API_URL=http://localhost:4000/api
