# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# --- Baza danych ---------------------------------------------------------
# Rola aplikacyjna: podlega RLS, używana przez API w czasie działania.
DATABASE_URL="postgresql://kelbroo_app:kelbroo_app@localhost:5432/kelbroo?schema=public"
# Rola właścicielska: omija RLS, używana wyłącznie przez migracje i seed.
DIRECT_DATABASE_URL="postgresql://kelbroo:kelbroo@localhost:5432/kelbroo?schema=public"

# --- Redis (pub/sub realtime, cache menu, rate limiting) ------------------
REDIS_URL="redis://localhost:6379"

# --- API ------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development

# --- Auth personelu -------------------------------------------------------
JWT_ACCESS_SECRET="zmien-mnie-w-srodowisku-lokalnym"
JWT_REFRESH_SECRET="zmien-mnie-tez"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Sesje gości ----------------------------------------------------------
GUEST_SESSION_SECRET="zmien-mnie-rowniez"
GUEST_SESSION_TTL_HOURS=6

# --- Etap 2 (płatności online) — nieużywane w etapie 1 --------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
