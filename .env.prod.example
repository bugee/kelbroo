# Konfiguracja produkcyjna. Skopiuj do .env.prod i uzupełnij.
# .env.prod NIE trafia do repozytorium.
#
# Sekrety generuj losowo, np.:  openssl rand -base64 36

# --- Domeny ---------------------------------------------------------------
# Muszą wskazywać na ten serwer rekordem A/AAAA, zanim wystartujesz Caddy'ego —
# certyfikat Let's Encrypt jest wystawiany przy pierwszym żądaniu.
#
# Domena produktowa. Caddy serwuje pod nią stronę produktową i przekierowuje
# www na apex. Zostaw pustą, jeśli wdrażasz sam panel i aplikację gościa.
LANDING_DOMAIN=kelbroo.com
GUEST_DOMAIN=menu.kelbroo.com
ADMIN_DOMAIN=panel.kelbroo.com
ACME_EMAIL=kontakt@kelbroo.com

# --- Baza i Redis ---------------------------------------------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Sekrety aplikacji ----------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GUEST_SESSION_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GUEST_SESSION_TTL_HOURS=6

# Rejestracja restauracji bez udziału administratora. Domyślnie OTWARTA.
# Zostaw pustą albo usuń, żeby korzystać z domyślnej wartości z compose;
# ustaw `false`, żeby awaryjnie zamknąć zakładanie kont bez wdrażania zmian.
REGISTRATION_ENABLED=true

# --- poczta wychodząca (Hostinger SMTP) ------------------------------------
# Bez SMTP_HOST wiadomości nie wychodzą, tylko trafiają do logu API. Rejestracja
# działa wtedy dalej, ale klient nie dostanie odnośnika potwierdzającego adres —
# a bez potwierdzenia nie zaloguje się do panelu.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=kontakt@kelbroo.com
SMTP_PASSWORD=
MAIL_FROM=kelbroo <kontakt@kelbroo.com>
# Skrzynka, na którą przychodzi powiadomienie o każdym nowym koncie.
MAIL_NOTIFY=kontakt@kelbroo.com
