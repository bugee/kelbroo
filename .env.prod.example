# Konfiguracja produkcyjna. Skopiuj do .env.prod i uzupełnij.
# .env.prod NIE trafia do repozytorium.
#
# Sekrety generuj losowo, np.:  openssl rand -base64 36

# --- Domeny ---------------------------------------------------------------
# Muszą wskazywać na ten serwer rekordem A/AAAA, zanim wystartujesz Caddy'ego —
# certyfikat Let's Encrypt jest wystawiany przy pierwszym żądaniu.
GUEST_DOMAIN=menu.twojarestauracja.pl
ADMIN_DOMAIN=panel.twojarestauracja.pl
ACME_EMAIL=ty@twojarestauracja.pl

# --- Baza i Redis ---------------------------------------------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Sekrety aplikacji ----------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GUEST_SESSION_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GUEST_SESSION_TTL_HOURS=6
