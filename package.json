{
  "name": "kelbroo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @kelbroo/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @kelbroo/api run db:seed",
    "db:studio": "pnpm --filter @kelbroo/api exec prisma studio",
    "test:e2e": "pnpm --filter @kelbroo/e2e test:e2e",
    "test:e2e:ui": "pnpm --filter @kelbroo/e2e test:e2e:ui"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
