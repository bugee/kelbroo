{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Świadomie bez "incremental": współdzielony plik .tsbuildinfo sprawiał, że
    // po `tsc --noEmit` (typecheck) kolejny build uznawał pliki za aktualne
    // i nie emitował JS-a — aplikacja kompilowała się "pomyślnie" do samych
    // deklaracji typów. Watch mode w Nest i Next ma własne cache.
    "incremental": false
  }
}
